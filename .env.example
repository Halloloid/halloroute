# RustAgent Configuration

# Server
HALLO_ROUTE_HOST=127.0.0.1
HALLO_ROUTE_PORT=20128

# Database
HALLO_ROUTE_DB_PATH=data/halloroute.db

# Logging
RUST_LOG=halloroute=debug,actix_web=info

# Provider API Keys (optional)
# Only needed for providers that require authentication
# OpenCode and Pollinations work without keys

# Groq (free tier: 14.4M tokens/day)
# Get key: https://console.groq.com
GROQ_API_KEY=

# Together AI (free tier: 1M tokens/day)
# Get key: https://www.together.ai
TOGETHER_API_KEY=

# HuggingFace (limited free tier)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
